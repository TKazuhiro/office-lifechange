---
import '../styles/global.css';
import { site, nav } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title}｜${site.name}` : `${site.name}｜${site.tagline}（岐阜・愛知・三重）`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const current = Astro.url.pathname;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="ja_JP" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'LegalService',
      name: site.name,
      url: site.url,
      telephone: site.tel,
      address: {
        '@type': 'PostalAddress',
        postalCode: site.postal.replace('〒', ''),
        addressRegion: '岐阜県',
        addressLocality: '揖斐郡池田町',
        streetAddress: '八幡998番地',
        addressCountry: 'JP',
      },
      areaServed: ['岐阜県', '愛知県', '三重県'],
      founder: { '@type': 'Person', name: site.representative },
    })} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap site-header__in">
        <a class="brand" href="/">
          <span class="brand__name">{site.name}</span>
          <span class="brand__sub">都市計画法・盛土規制法・農地法の許認可申請</span>
        </a>
        <button class="menu-btn" aria-label="メニュー" aria-expanded="false" aria-controls="gnav">☰</button>
        <nav id="gnav" class="gnav">
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} aria-current={current.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__in">
        <div>
          <p class="site-footer__name">{site.name}</p>
          <p class="small">
            {site.postal} {site.address}<br />
            行政書士 {site.representative}<br />
            TEL {site.tel}（{site.hours}）<br />
            適格請求書発行事業者登録番号 {site.invoiceNo}
          </p>
        </div>
        <ul class="site-footer__nav">
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href="/privacy/">プライバシーポリシー</a></li>
        </ul>
      </div>
      <p class="copyright">© {new Date().getFullYear()} {site.name}</p>
    </footer>

    <script>
      const btn = document.querySelector('.menu-btn');
      const nav = document.getElementById('gnav');
      btn?.addEventListener('click', () => {
        const open = nav?.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', String(!!open));
      });
    </script>
  </body>
</html>

<style>
  .site-header { background: var(--surface); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 10; }
  .site-header__in { display: flex; align-items: center; justify-content: space-between; min-height: 64px; gap: 1rem; flex-wrap: wrap; }
  .brand { text-decoration: none; display: flex; flex-direction: column; line-height: 1.25; padding: .6rem 0; }
  .brand__name { font-weight: 800; color: var(--navy-dark); font-size: 1.15rem; letter-spacing: .02em; }
  .brand__sub { font-size: .7rem; color: var(--muted); }
  .gnav ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 1.2rem; }
  .gnav a { text-decoration: none; font-size: .92rem; font-weight: 600; color: var(--text); padding: .4em 0; border-bottom: 2px solid transparent; }
  .gnav a:hover, .gnav a[aria-current="page"] { border-color: var(--accent); color: var(--navy); }
  .menu-btn { display: none; background: none; border: 1px solid var(--line); border-radius: 6px; font-size: 1.3rem; padding: .2em .55em; cursor: pointer; color: var(--navy); }
  @media (max-width: 820px) {
    .menu-btn { display: block; }
    .gnav { display: none; width: 100%; padding-bottom: .8rem; }
    .gnav.is-open { display: block; }
    .gnav ul { flex-direction: column; gap: 0; }
    .gnav a { display: block; padding: .7em .2em; border-bottom: 1px solid var(--line); }
  }
  .site-footer { background: var(--navy-dark); color: #d9e0ea; margin-top: 4rem; padding: 2.5rem 0 1rem; }
  .site-footer a { color: #d9e0ea; text-decoration: none; }
  .site-footer a:hover { color: #fff; text-decoration: underline; }
  .site-footer .small { color: #b7c2d1; }
  .site-footer__in { display: flex; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
  .site-footer__name { font-weight: 800; font-size: 1.1rem; color: #fff; margin-bottom: .4em; }
  .site-footer__nav { list-style: none; margin: 0; padding: 0; display: grid; gap: .3em; }
  .copyright { text-align: center; font-size: .78rem; color: #8fa0b5; margin: 2rem 0 0; }
</style>
