---
import '../styles/global.css';
import { site, nav } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title}｜${site.name}` : `${site.name}｜${site.tagline}（岐阜・愛知・三重）`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const current = Astro.url.pathname;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="format-detection" content="telephone=no" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500&family=Onest:wght@200;300;400&display=swap" rel="stylesheet" />
    <link rel="icon" href="/images/logo_1.png" type="image/png" />
    <link rel="apple-touch-icon" href="/images/logo_1.png" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/images/logo_1.png', site.url).href} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="ja_JP" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'LegalService',
      name: site.name,
      url: site.url,
      telephone: site.tel,
      address: {
        '@type': 'PostalAddress',
        postalCode: site.postal.replace('〒', ''),
        addressRegion: '岐阜県',
        addressLocality: '揖斐郡池田町',
        streetAddress: '八幡998番地',
        addressCountry: 'JP',
      },
      areaServed: ['岐阜県', '愛知県', '三重県'],
      founder: { '@type': 'Person', name: site.representative },
    })} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap site-header__in">
        <a class="brand" href="/">
          <img class="brand__mark" src="/images/logo_1.png" alt="" width="500" height="500" />
          <span class="brand__text">
            <span class="brand__name">{site.name}</span>
            <span class="brand__sub">都市計画法・盛土規制法・農地法の許認可申請</span>
          </span>
        </a>
        <div class="site-header__right">
          <a class="btn hdr-contact" href="/contact/">✉ お問い合わせ</a>
          <a class="tel-link hdr-tel" href={`tel:${site.tel.replace(/-/g, '')}`}>{site.tel}</a>
          <button class="menu-btn" aria-label="メニュー" aria-expanded="false" aria-controls="gnav"><span></span><span></span></button>
        </div>
        <nav id="gnav" class="gnav">
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} aria-current={current.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__in">
        <div>
          <p class="site-footer__name"><img src="/images/logo_1.png" alt="" width="500" height="500" /><span>{site.name}</span></p>
          <p class="small">
            {site.postal} {site.address}<br />
            行政書士 {site.representative}<br />
            TEL <a href={`tel:${site.tel.replace(/-/g, '')}`}>{site.tel}</a><br />
            {site.hours}<br />
            適格請求書発行事業者登録番号 {site.invoiceNo}
          </p>
        </div>
        <ul class="site-footer__nav">
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href="/privacy/">プライバシーポリシー</a></li>
        </ul>
      </div>
      <p class="copyright">© {new Date().getFullYear()} {site.name}</p>
    </footer>

    <dialog class="zoom" id="zoomDialog" aria-label="図解の拡大表示">
      <span class="zoom__tip">ピンチ／スクロールで拡大・移動できます</span>
      <button class="zoom__close" type="button" data-close>閉じる ✕</button>
      <div class="zoom__scroll" data-body></div>
    </dialog>

    <script>
      const btn = document.querySelector('.menu-btn');
      const nav = document.getElementById('gnav');
      btn?.addEventListener('click', () => {
        const open = nav?.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', String(!!open));
      });

      // 図解のクリック拡大
      const dlg = document.getElementById('zoomDialog') as HTMLDialogElement | null;
      const body = dlg?.querySelector('[data-body]');
      document.querySelectorAll('figure[data-zoom] svg').forEach((svg) => {
        svg.setAttribute('role', 'button');
        svg.setAttribute('tabindex', '0');
        const open = () => {
          if (!dlg || !body) return;
          body.innerHTML = '';
          body.appendChild(svg.cloneNode(true));
          dlg.showModal();
        };
        svg.addEventListener('click', open);
        svg.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') { e.preventDefault(); open(); } });
      });
      dlg?.querySelector('[data-close]')?.addEventListener('click', () => dlg.close());
      dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    </script>
  </body>
</html>

<style>
  /* 旧HPのヘッダー: 左にロゴ画像、右に「お問い合わせ」ボタンと電話番号、ナビは下段（スマホはハンバーガー） */
  .site-header { background: rgba(255,255,255,.96); backdrop-filter: blur(6px); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 10; }
  .site-header__in { display: grid; grid-template-columns: 1fr auto; align-items: center; min-height: 80px; column-gap: 1rem; row-gap: 0; }
  .brand { text-decoration: none; display: flex; align-items: center; gap: .7rem; line-height: 1.25; padding: .6rem 0; }
  .brand:hover { opacity: 1; }
  .brand__mark { width: 44px; height: 44px; flex: 0 0 44px; display: block; }
  .brand__text { display: flex; flex-direction: column; }
  .brand__name { font-weight: 500; color: var(--navy-dark); font-size: 1.2rem; letter-spacing: .12em; white-space: nowrap; }
  .brand__sub { font-size: .7rem; color: var(--muted); letter-spacing: .08em; white-space: nowrap; }
  @media (max-width: 420px) { .brand__sub { display: none; } }
  .site-header__right { display: flex; align-items: center; gap: 1.2rem; }
  .hdr-contact { font-size: .86rem; padding: .7em 1.4em; }
  .hdr-tel { font-size: 1.25rem; }
  .gnav { grid-column: 1 / -1; }
  .gnav ul { list-style: none; margin: 0; padding: 0 0 .6rem; display: flex; gap: 2rem; }
  .gnav a { text-decoration: none; font-size: .86rem; font-weight: 400; letter-spacing: .12em; color: var(--text); padding: .3em 0; border-bottom: 1px solid transparent; }
  .gnav a:hover, .gnav a[aria-current="page"] { border-color: var(--blue); color: var(--blue); opacity: 1; }
  .menu-btn { display: none; background: none; border: 0; width: 34px; height: 30px; padding: 0; cursor: pointer; position: relative; }
  .menu-btn span { position: absolute; left: 4px; right: 4px; height: 1px; background: var(--blue); }
  .menu-btn span:nth-child(1) { top: 10px; } .menu-btn span:nth-child(2) { top: 19px; }
  @media (max-width: 820px) {
    .site-header__in { min-height: 64px; }
    .brand__mark { width: 36px; height: 36px; flex-basis: 36px; }
    .brand__name { font-size: 1.05rem; }
    .hdr-contact, .hdr-tel { display: none; }
    .menu-btn { display: block; }
    .gnav { display: none; width: 100%; padding-bottom: .8rem; }
    .gnav.is-open { display: block; }
    .gnav ul { flex-direction: column; gap: 0; }
    .gnav a { display: block; padding: .8em .2em; border-bottom: 1px solid var(--line); }
  }
  /* フッター: 白地・薄青の帯（旧HP） */
  .site-footer { background: linear-gradient(180deg, rgba(255,255,255,0) 0%, var(--blue-09) 100%); color: var(--text); margin-top: 4rem; padding: 3rem 0 1rem; border-top: 1px solid var(--line); }
  .site-footer a { color: var(--text); text-decoration: none; }
  .site-footer a:hover { color: var(--blue); opacity: 1; }
  .site-footer .small { color: var(--muted); }
  .site-footer__in { display: flex; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
  .site-footer__name { margin-bottom: .8em; display: flex; align-items: center; gap: .6rem; font-size: 1.1rem; letter-spacing: .12em; font-weight: 500; color: var(--navy-dark); }
  .site-footer__name img { width: 36px; height: 36px; display: block; }
  .site-footer__nav { list-style: none; margin: 0; padding: 0; display: grid; gap: .3em; font-size: .9rem; }
  .copyright { text-align: center; font-size: .76rem; color: var(--muted); margin: 2rem 0 0; letter-spacing: .1em; }
</style>
