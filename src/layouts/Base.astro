---
// 全ページ共通の枠（新デザイン ver0.2・2026-10-10）。ヘッダー・最後の相談の帯・フッター
import '../styles/redesign.css';
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  cta?: boolean; // 最後の相談の帯を出すか（お問い合わせページでは出さない）
}
const { title, description = site.description, cta = true } = Astro.props;
const fullTitle = title ? `${title}｜${site.name}` : `${site.name}｜土地の許認可で、着工を止めない。`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const telHref = `tel:${site.tel.replace(/-/g, '')}`;
// 本番（main）以外のプレビューは検索に載せない（Cloudflare Pages がビルド時に CF_PAGES_BRANCH を渡す）
const branch = process.env.CF_PAGES_BRANCH ?? 'local';
const noindex = branch !== 'main';
const current = Astro.url.pathname;
const nav = [
  { href: '/#purpose', label: '目的から探す' },
  { href: '/onestop/', label: '調査から申請まで' },
  { href: '/partners/', label: '士業・事業者の方へ' },
  { href: '/about/', label: '事務所について' },
];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="format-detection" content="telephone=no" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500&family=Zen+Old+Mincho:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="icon" href="/images/logo_1.png" type="image/png" />
    <link rel="apple-touch-icon" href="/images/logo_1.png" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/images/logo_1.png', site.url).href} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="ja_JP" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'LegalService',
      name: site.name,
      url: site.url,
      telephone: site.tel,
      address: {
        '@type': 'PostalAddress',
        postalCode: site.postal.replace('〒', ''),
        addressRegion: '岐阜県',
        addressLocality: '揖斐郡池田町',
        streetAddress: '八幡998番地',
        addressCountry: 'JP',
      },
      areaServed: ['岐阜県', '愛知県', '三重県'],
      founder: { '@type': 'Person', name: site.representative },
    })} />
  </head>
  <body>
    <header class="v2-hdr">
      <a class="v2-logo" href="/">
        <img src="/images/logo_1.png" alt="" width="500" height="500" />
        <span><span class="nm">{site.name}</span><span class="sub">都市計画法・盛土規制法・農地法の許認可</span></span>
      </a>
      <button class="v2-menu" type="button" aria-label="メニュー" aria-expanded="false" aria-controls="v2nav"><span></span><span></span><span></span></button>
      <nav id="v2nav" class="v2-nav">
        {nav.map((n) => <a href={n.href} aria-current={current.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
        <a class="btn" href="/contact/">お問い合わせ</a>
      </nav>
    </header>

    <main><slot /></main>

    {cta && (
      <section class="v2-cta" aria-labelledby="v2-cta-h">
        <div>
          <h2 id="v2-cta-h">まずは、土地の場所と<br />やりたいことを教えてください。</h2>
          <p class="hint">地番が分からなくても大丈夫です。</p>
        </div>
        <div class="right">
          <a class="tel" href={telHref}>{site.tel}</a>
          <p class="hrs">{site.hours}</p>
          <a class="btn" href="/contact/">相談フォームへ</a>
        </div>
      </section>
    )}

    <footer class="v2-ftr">
      <span>{site.name}　{site.postal} {site.address}　行政書士 {site.representative}（登録番号 {site.registrationNo}）　適格請求書発行事業者登録番号 {site.invoiceNo}</span>
      <span class="v2-ftr__links"><a href="/services/">業務一覧</a>　<a href="/area/">対応エリア</a>　<a href="/privacy/">プライバシーポリシー</a></span>
    </footer>

    <dialog class="zoom" id="zoomDialog" aria-label="図解の拡大表示">
      <span class="zoom__tip">ピンチ／スクロールで拡大・移動できます</span>
      <button class="zoom__close" type="button" data-close>閉じる ✕</button>
      <div class="zoom__scroll" data-body></div>
    </dialog>

    <script>
      const btn = document.querySelector('.v2-menu');
      const nav = document.getElementById('v2nav');
      btn?.addEventListener('click', () => {
        const open = nav?.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', String(!!open));
      });

      // 図解のクリック拡大
      const dlg = document.getElementById('zoomDialog') as HTMLDialogElement | null;
      const body = dlg?.querySelector('[data-body]');
      document.querySelectorAll('figure[data-zoom] svg').forEach((svg) => {
        svg.setAttribute('role', 'button');
        svg.setAttribute('tabindex', '0');
        const open = () => {
          if (!dlg || !body) return;
          body.innerHTML = '';
          body.appendChild(svg.cloneNode(true));
          dlg.showModal();
        };
        svg.addEventListener('click', open);
        svg.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') { e.preventDefault(); open(); } });
      });
      dlg?.querySelector('[data-close]')?.addEventListener('click', () => dlg.close());
      dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    </script>
  </body>
</html>
