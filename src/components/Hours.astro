---
/**
 * 営業時間のドット表（旧HPの部品を継承）
 * 受付は平日 9:00〜18:00（site.ts と一致させる）。土日祝は休業として表示。
 */
import { site } from '../data/site';
const days = ['月', '火', '水', '木', '金', '土', '日'];
const open = [true, true, true, true, true, false, false];
---
<div class="hours">
  <div class="hours__row">
    <span class="hours__label">受付時間</span>
    {days.map((d) => <span>{d}</span>)}
    <span class="hours__time">09:00 - 18:00</span>
    {open.map((o) => <i aria-label={o ? '受付' : '休業'}>{o ? '●' : '／'}</i>)}
  </div>
  <p class="hours__legend"><i>●</i>… 受付日　<i>／</i>… 休業</p>
  <div class="hours__notes">
    <p>※祝・祭日は休業となります</p>
    <p>※メールフォームは24時間受け付けています</p>
  </div>
  <p class="hours__contact">
    <a class="tel-link" href={`tel:${site.tel.replace(/-/g, '')}`}>{site.tel}</a>
    <a class="btn" href="/contact/">✉ お問い合わせ</a>
  </p>
</div>

<style>
  .hours__contact { display: flex; align-items: center; gap: 1.2rem; flex-wrap: wrap; margin: 1rem 0 0; }
</style>
