---
/** 排水先の確認（雨水と汚水を分ける）。2026-10-11 Codex 案を Claude 精査のうえ移植。
 *  放流先と必要な許可を一対一に結ばない（確認する内容を並べる図）。
 *  list=false で「水路や管を使うときに確認すること」を省く（占用ページは本文に同じ表がある） */
interface Props { list?: boolean }
const { list = true } = Astro.props;
const dests = [
  ['道路の側溝・水路、河川', '管理者と接続の条件'],
  ['農業用の水路', '土地改良区などの管理者と利用の条件'],
  ['里道・水路などの公共用地', '土地や施設の管理者と使い方の条件'],
  ['公共下水道', '使える区域と接続の条件'],
  ['ほかの方の管・土地', '所有者と使用の承諾'],
];
---
<div class="dr">
  <article class="dr-col">
    <div class="dr-head">
      <svg class="dr-icon" viewBox="0 0 48 48" aria-hidden="true"><path d="M12 25a8 8 0 0 1-1-16 11 11 0 0 1 21-1 8 8 0 1 1 3 17H12M15 32l-3 6m14-6-3 6m14-6-3 6" /></svg>
      <div><p class="dr-k">雨水</p><p class="dr-t">屋根や敷地に降る雨</p></div>
    </div>
    <ol class="dr-route">
      <li><span>01</span>周りの側溝・水路を調べる</li>
      <li><span>02</span>つなぐ経路と高さを確かめる</li>
      <li><span>03</span>管理者に条件を確かめる</li>
    </ol>
    <p class="dr-p">敷地から先のつながりまで調べて、排水の計画を考えます。</p>
  </article>
  <article class="dr-col">
    <div class="dr-head">
      <svg class="dr-icon" viewBox="0 0 48 48" aria-hidden="true"><path d="m5 22 19-16 19 16M10 19v23h28V19M20 42V28h8v14M17 21h3m9 0h3" /></svg>
      <div><p class="dr-k">汚水</p><p class="dr-t">台所・お風呂・トイレの水</p></div>
    </div>
    <p class="dr-p dr-intro">公共下水道を使えるかを調べて、処理の方法を確かめます。</p>
    <ul class="dr-choice">
      <li><span>公共下水道を使う場合</span>つなぐ先と条件を確かめます。</li>
      <li><span>浄化槽を使う場合</span>処理したあとの水の行き先を確かめます。</li>
    </ul>
  </article>
</div>
<p class="dr-cap">確かめる内容を並べた図です。現地の水の流れや、つなげる場所を示すものではありません。</p>
{list && (
  <details class="dr-more">
    <summary>水路や管を使うときに確かめること</summary>
    <ul>{dests.map(([a, b]) => <li><b>{a}</b><span>{b}</span></li>)}</ul>
  </details>
)}

<style>
  .dr { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; margin: 1.5rem 0 0; }
  .dr-head { display: flex; align-items: center; gap: 18px; }
  .dr-icon { width: 48px; height: 48px; flex: none; fill: none; stroke: var(--ink); stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round; }
  .dr-k { font-size: .75rem; letter-spacing: .14em; color: var(--accent); margin: 0; }
  .dr-t { font-family: var(--mincho); font-size: 1.125rem; color: var(--ink); margin: 0; }
  .dr-route, .dr-choice { list-style: none; padding: 0; margin: 1.2rem 0; }
  .dr-route li, .dr-choice li { border-top: 1px solid var(--line); padding: .8rem 0; font-size: .9375rem; color: var(--ink); }
  .dr-route li:last-child, .dr-choice li:last-child { border-bottom: 1px solid var(--line); }
  .dr-route span { font-size: .75rem; letter-spacing: .14em; color: var(--accent); margin-right: 1rem; }
  .dr-choice span { display: block; font-size: .75rem; color: var(--accent); margin-bottom: .2rem; }
  .dr-p { font-size: .875rem; color: var(--sub); }
  .dr-intro { margin-top: 1.2rem; }
  .dr-cap { font-size: .75rem; color: var(--sub); margin: 1rem 0 0; }
  .dr-more { margin: 1.2rem 0 2rem; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .dr-more summary { cursor: pointer; padding: .9rem 0; font-size: .9375rem; }
  .dr-more ul { list-style: none; margin: 0; padding: 0 0 .8rem; }
  .dr-more li { display: flex; justify-content: space-between; gap: 16px; padding: .5rem 0; font-size: .875rem; }
  .dr-more b { font-weight: 500; }
  .dr-more span { color: var(--sub); }
  @media (max-width: 760px) {
    .dr { grid-template-columns: 1fr; gap: 28px; }
    .dr-more li { display: block; }
    .dr-more span { display: block; }
  }
</style>
