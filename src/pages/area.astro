---
import Base from '../layouts/Base.astro';
import { areas } from '../data/site';
---
<Base title="対応エリア" description="Life行政書士事務所の対応エリア。岐阜県全域、愛知県（名古屋市・一宮市・稲沢市ほか）、三重県（桑名市・四日市市・鈴鹿市・松阪市ほか）で、現地の調査から許認可の申請までお受けしています。">
  <div class="wrap">
    <p class="breadcrumb"><a href="/">ホーム</a> › 対応エリア</p>
    <div class="page-head">
      <h1>対応エリア</h1>
      <p class="lead">
        池田町（岐阜県揖斐郡）の事務所から、岐阜県・愛知県・三重県の次の地域へうかがいます。役所での協議や現地の調査があるので主な地域を決めていますが、近くの地域もご相談ください。
      </p>
    </div>

    <div class="prefs">
      {areas.map((a) => (
        <section class="pref">
          <h2>{a.pref}</h2>
          {a.note ? (
            <p class="pref__note">{a.note}</p>
          ) : (
            <ul class="cities">
              {a.cities.map((c) => <li>{c}</li>)}
            </ul>
          )}
        </section>
      ))}
    </div>

    <div class="note">
      <strong>自治体ごとに、決まりが違います。</strong>開発許可・建築許可の基準や、盛土規制法・農地法の窓口の進め方は、自治体ごとに違います。当事務所では調べたことを自治体ごとに記録して、次の案件に生かしています。ここにない自治体でも、調べるところからお受けします。
    </div>

  </div>
</Base>

<style>
  .prefs { display: grid; gap: 1.5rem; margin-top: 1rem; }
  .pref { border-top: 1px solid var(--ink); padding: 1.1rem 0 .4rem; }
  .wrap .pref h2 { margin: 0 0 .6em; padding: 0; border: 0; font-size: 1.25rem; }
  .wrap .pref__note { font-size: 1rem; color: var(--ink); margin: 0; }
  .wrap .cities { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .5rem .6rem; }
  .wrap .cities li { background: var(--mist); padding: .25em .9em; margin: 0; font-size: .92rem; color: var(--ink); line-height: 1.7; }
</style>
