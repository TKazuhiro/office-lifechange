---
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? site.turnstileSiteKey ?? '';
---
<Base cta={false} title="お問い合わせ" description="Life行政書士事務所へのご相談・見積のご依頼。土地の場所と、どのように使いたいかを、分かる範囲でお聞かせください。役所で調べたあとに見積をお出しします。">
  <div class="wrap">
    <p class="breadcrumb"><a href="/">ホーム</a> › お問い合わせ</p>
    <div class="page-head">
      <h1>お問い合わせ</h1>
      <p class="lead">
        ご相談・見積のご依頼は、下のフォームからお送りください。分かる範囲で大丈夫です。地番が分からなくても、ご相談いただけます。原則として2営業日以内にお返事します。初回のご相談は無料です。お返事した担当が、そのまま最後までご一緒します。
      </p>
    </div>

    <div class="grid grid--2 contact">
      <form class="form" method="post" action="/api/contact">
        <label><span class="lbl">お名前 <span class="req">必須</span></span>
          <input type="text" name="name" required autocomplete="name" />
        </label>
        <label>会社名・事務所名
          <input type="text" name="company" autocomplete="organization" />
        </label>
        <label><span class="lbl">メールアドレス <span class="req">必須</span></span>
          <input type="email" name="email" required autocomplete="email" />
        </label>
        <label>電話番号
          <input type="tel" name="tel" autocomplete="tel" />
        </label>
        <label>ご相談の種類
          <select name="type">
            <option value="見積のご依頼">見積のご依頼</option>
            <option value="ご相談">ご相談（進め方・できるかどうかの確認）</option>
            <option value="役所調査のみ">役所調査だけのご依頼</option>
            <option value="その他">その他</option>
          </select>
        </label>
        <label>自治体・所在地（地番まで分かれば）
          <input type="text" name="place" placeholder="例: 岐阜県揖斐郡池田町○○ 123番" />
        </label>
        <label>今の状態・地目
          <input type="text" name="status" placeholder="例: 農地（田）／宅地／雑種地、市街化調整区域" />
        </label>
        <label>希望時期
          <input type="text" name="timing" placeholder="例: 年内に着工したい" />
        </label>
        <label><span class="lbl">ご相談内容 <span class="req">必須</span></span>
          <textarea name="message" rows="7" required placeholder="建てる・造成する予定、お手元の資料（登記事項証明書・公図・測量図など）があるか、ほかに聞きたいこと"></textarea>
        </label>
        <input type="text" name="website" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
        {turnstileKey && <div class="cf-turnstile" data-sitekey={turnstileKey}></div>}
        <p class="small">お送りいただいた情報は、お問い合わせへの対応のほかには使いません（<a href="/privacy/">プライバシーポリシー</a>）。</p>
        <button class="btn" type="submit">送信する</button>
      </form>

      <aside>
        <div class="card">
          <h3>お電話でのご相談</h3>
          <p><a class="tel" href={`tel:${site.tel.replace(/-/g, '')}`}>{site.tel}</a></p>
          <p class="small">{site.hours}<br />役所や現地に出ていることが多いので、つながらないときはフォームをお使いください。</p>
        </div>
        <div class="card" style="margin-top:1rem">
          <h3>教えていただけると早く進むこと</h3>
          <ul class="small">
            <li>自治体名・所在地（地番）</li>
            <li>今の状態（宅地か農地か、現況測量があるか）</li>
            <li>建てる・造成する予定（自宅用か事業用か など）</li>
            <li>雨水をどこへ流すか（分かれば）</li>
            <li>希望の時期・期限</li>
          </ul>
          <p class="small">登記事項証明書・公図・測量図がお手元にあれば、お返事のあとにお送りください。</p>
        </div>
      </aside>
    </div>
  </div>
  {turnstileKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</Base>

<style>
  .contact { align-items: start; margin-top: 1rem; }
  .form { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.5rem; display: grid; gap: 1rem; }
  .form label { display: grid; gap: .3em; font-weight: 500; font-size: .95rem; }
  .form input, .form select, .form textarea { font: inherit; padding: .6em .8em; border: 1px solid #cfcac0; border-radius: 6px; background: #fff; width: 100%; }
  .form textarea { resize: vertical; }
  .lbl { display: flex; align-items: center; gap: .4em; }
  .req { justify-self: start; display: inline-block; font-size: .75rem; color: #fff; background: var(--accent); border-radius: 0; padding: .1em .5em; margin-left: .3em; vertical-align: middle; }
  .hp { position: absolute; left: -9999px; }
  .tel { font-size: 1.4rem; font-weight: 400; font-family: var(--font-en); text-decoration: none; }
</style>
