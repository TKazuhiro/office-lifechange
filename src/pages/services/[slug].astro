---
import Base from '../../layouts/Base.astro';
import Flow from '../../components/Flow.astro';
import DrainageMap from '../../components/DrainageMap.astro';
import ZoneMap from '../../components/ZoneMap.astro';
import MoridoGuide from '../../components/MoridoGuide.astro';
import LandScenes from '../../components/LandScenes.astro';
import SiteCheck from '../../components/SiteCheck.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((s) => ({ params: { slug: s.id }, props: { entry: s } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Base title={d.title} description={d.summary}>
  <div class="wrap">
    <p class="breadcrumb"><a href="/">ホーム</a> › <a href="/services/">業務一覧</a> › {d.title}</p>
    <div class="page-head">
      <span class="tag">{d.law}</span>
      <h1>{d.title.split('（')[0]}{d.title.includes('（') && <span class="h1-sub">（{d.title.split('（').slice(1).join('（')}</span>}</h1>
      <p class="lead">{d.short}</p>
    </div>

    {d.image && (
      <figure class="keyvisual">
        <img src={d.image} alt={d.imageAlt ?? ''} width="1600" height="893" loading="eager" fetchpriority="high" />
        <figcaption class="small">{d.imageAlt?.replace('（イメージ）', '')}のイメージ（画像はAI生成）</figcaption>
      </figure>
    )}

    <dl class="meta">
      <div><dt>期間の目安</dt><dd>{d.period}</dd></div>
      <div><dt>費用</dt><dd>調査の前は幅で、役所で調べたあとに確定した金額をお出しします（くわしくは下の「費用はどう決まる？」）</dd></div>
    </dl>

    {d.steps.length > 0 && (
      <section class="flowbox">
        <h2 class="flowbox__h">ひと目でわかる流れ</h2>
        <Flow steps={d.steps} />
      </section>
    )}

    <article class="prose">
      <Content />
    </article>

    {d.diagram === 'drainage' && (
      <section class="diagram">
        <h2>排水先も、一緒に確かめます</h2>
        <DrainageMap list={entry.id !== 'senyo'} />
      </section>
    )}
    {d.diagram === 'site' && (
      <section class="diagram">
        <h2>田んぼを宅地にする前に、確かめる場所</h2>
        <SiteCheck />
      </section>
    )}
    {d.diagram === 'morido' && (<>
      <section class="diagram">
        <h2>どんな造成をしますか？</h2>
        <LandScenes />
      </section>
      <section class="diagram">
        <h2>あなたの計画は、盛土規制法の対象？</h2>
        <MoridoGuide />
      </section>
    </>)}
    {d.diagram === 'zone' && (
      <section class="diagram">
        <h2>土地の区域で、必要な手続きが変わります</h2>
        <ZoneMap />
      </section>
    )}

    <div class="note">
      手続きの細かい決まり（書類・審査の期間・手数料・基準の当てはめ方）は、<strong>自治体ごとに違います</strong>。
      ここに書いたのは一般的な流れと、当事務所のこれまでの目安です。あなたの土地の場合は、役所で調べてからお伝えします。
    </div>

  </div>
</Base>

<style>
  .keyvisual { margin: 0 0 1.5rem; }
  .keyvisual img { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radius); display: block; }
  .keyvisual figcaption { margin-top: .4rem; color: var(--muted); }
  .meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 1rem 1.3rem; margin: 0 0 2rem; }
  .meta dt { font-size: .875rem; color: var(--muted); }
  .meta dd { margin: 0; font-weight: 400; }
  .flowbox { margin: 0 0 2rem; }
  .flowbox__h { margin-top: 0; }
</style>
