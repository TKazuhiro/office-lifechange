---
import Base from '../../layouts/Base.astro';
import ZoneMap from '../../components/ZoneMap.astro';
import { getCollection } from 'astro:content';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="業務一覧" description="Life行政書士事務所の取扱業務。開発許可（29条）・建築許可（43条）・60条証明・盛土規制法・農地転用・河川法・道路水路の占用許可。期間の目安と費用の決まり方を載せています。">
  <div class="wrap">
    <p class="breadcrumb"><a href="/">ホーム</a> › 業務一覧</p>
    <div class="page-head">
      <h1>業務一覧</h1>
      <p class="lead">土地の許認可を専門にしています。調査も、図面も、申請も、ひとつの事務所で受け持ちます。期間は目安で、金額は役所で調べたあとに確定した金額をお出しします。</p>
    </div>

    <h2 style="margin-top:1rem">どの手続きが必要になる？</h2>
    <p>土地がどの区域にあるか、造成をするか、農地かどうかで、必要な手続きが決まります。まず全体を見てみてください。</p>
    <ZoneMap />

    <h2>業務の一覧</h2>
    <div class="list">
      {services.map((s) => {
        const [main, ...rest] = s.data.title.split('（');
        return (
          <a class="card svc" href={`/services/${s.id}/`}>
            <div class="svc__head">
              <span class="tag">{s.data.law}</span>
              <h2>{main}{rest.length > 0 && <span class="svc__sub">（{rest.join('（')}</span>}</h2>
              <p>{s.data.short}</p>
            </div>
            <dl class="svc__meta">
              <div><dt>期間の目安</dt><dd>{s.data.period}</dd></div>
              <div><dt>費用の決まり方</dt><dd>{s.data.fee}</dd></div>
            </dl>
            <span class="more">詳しく見る →</span>
          </a>
        );
      })}
    </div>

    <div class="note">
      <strong>ここにない手続きも、ご相談ください。</strong>埋蔵文化財の工事の届出、砂防指定地での行為の許可、雨水浸透阻害行為の許可、条例に基づく届出など、土地の許認可にかかわる手続きをお受けしています。
    </div>

  </div>
</Base>

<style>
  .list { display: grid; gap: 1.2rem; margin-top: 1.5rem; }
  .svc h2 { border: 0; padding: 0; margin: .2em 0 .3em; font-size: 1.25rem; }
  .svc__sub { display: block; font-size: .7em; color: var(--sub); letter-spacing: .06em; }
  .svc p { margin-bottom: .6em; }
  .svc__meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: .6rem 1.5rem; margin: .8em 0; padding-top: .8em; border-top: 1px dashed var(--line); }
  .svc__meta dt { font-size: .875rem; color: var(--muted); }
  .svc__meta dd { margin: 0; font-size: .95rem; line-height: 1.8; }
</style>
